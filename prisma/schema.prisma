// ============================================================
// AuditForge — Prisma Schema v0.4
// Council Review: CR-AUDITFORGE-001 + CR-AUDITFORGE-004
// 
// v0.3 base:
//   1. Effective dating on bridge tables
//   2. Dim_ControlType dimension
//   3. Workflow state machine + ControlStatusLog
//   4. AuditTrail table
//   5. Template snapshot on GeneratedDocument
//
// v0.4 additions (CR-AUDITFORGE-004 ratified):
//   6. Auditor
//   7. Fact_Audit (planning layer)
//   8. Bridge_Audit_Control (audit scope)
//   9. AuditType, AuditStatus, ScopeDecision enums
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// DIMENSION TABLES
// ============================================================

// ============================================================
// AuditForge — Auth Schema Additions
// Add these models to prisma/schema.prisma
// Place BEFORE the existing Company model
// ============================================================

// ──── Enums ────

enum PermissionTier {
  ADMIN
  PREPARER
  REVIEWER
  APPROVER
  VIEWER

  @@map("user_role")
}

// ──── User ────

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String         @map("password_hash")
  role         PermissionTier @default(PREPARER)
  companyId    String?        @map("company_id")
  employeeId   String?        @map("employee_id")
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  lastLoginAt  DateTime?      @map("last_login_at")

  company  Company?  @relation(fields: [companyId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])
  sessions Session[]
  invites  Invite[]  @relation("InvitedBy")

  @@map("dim_user")
}

// ──── Session ────

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_session")
}

// ──── Invite ────

model Invite {
  id          String    @id @default(cuid())
  email       String
  companyId   String    @map("company_id")
  role        PermissionTier @default(PREPARER)
  token       String    @unique @default(cuid())
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company   Company @relation(fields: [companyId], references: [id])
  invitedBy User    @relation("InvitedBy", fields: [invitedById], references: [id])

  @@map("auth_invite")
}

model Company {
  id            String        @id @default(cuid())
  companyId     String        @unique @map("company_id")
  name          String
  industry      String
  size          CompanySize   @default(MEDIUM)
  publicPrivate PublicPrivate @default(PRIVATE) @map("public_private")
  fiscalYearEnd String        @map("fiscal_year_end")
  address       String?
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  controls  Control[]
  processes Process[]
  risks     Risk[]
  periods   Period[]
  scopes    Scope[]
  employees Employee[]
  audits    Audit[]
  users     User[]
  invites   Invite[]
  billingRates BillingRate[]
  invoices     Invoice[]
  arEntries    AREntry[]
  findings     Finding[]
  roles        Role[]
  departments  Department[]
  payrollRuns  PayrollRun[]

  @@map("dim_company")
}

model Process {
  id             String   @id @default(cuid())
  processId      String   @map("process_id")
  companyId      String   @map("company_id")
  processArea    String   @map("process_area")
  processName    String   @map("process_name")
  subprocessName String?  @map("subprocess_name")
  processOwner   String?  @map("process_owner")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  controls Control[]

  @@unique([companyId, processId])
  @@map("dim_process")
}

model Risk {
  id                 String       @id @default(cuid())
  riskId             String       @map("risk_id")
  companyId          String       @map("company_id")
  description        String
  category           RiskCategory @default(OPERATIONAL)
  likelihood         RiskRating   @default(MEDIUM)
  impact             RiskRating   @default(MEDIUM)
  inherentRiskRating RiskRating   @default(MEDIUM) @map("inherent_risk_rating")
  residualRiskRating RiskRating?  @map("residual_risk_rating")
  riskResponse       String?      @map("risk_response")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  controls ControlRisk[]

  @@unique([companyId, riskId])
  @@map("dim_risk")
}

model Framework {
  id                     String   @id @default(cuid())
  frameworkName          String   @map("framework_name")
  frameworkVersion       String?  @map("framework_version")
  domain                 String?
  requirementId          String   @map("requirement_id")
  requirementDescription String   @map("requirement_description")
  createdAt              DateTime @default(now()) @map("created_at")

  controls ControlFramework[]

  @@unique([frameworkName, requirementId])
  @@map("dim_framework")
}

model Period {
  id          String     @id @default(cuid())
  companyId   String     @map("company_id")
  periodLabel String     @map("period_label")
  periodStart DateTime   @map("period_start")
  periodEnd   DateTime   @map("period_end")
  periodType  PeriodType @default(ANNUAL) @map("period_type")
  createdAt   DateTime   @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  controls Control[]
  audits   Audit[]

  @@unique([companyId, periodLabel])
  @@map("dim_period")
}

model ControlObjective {
  id                String            @id @default(cuid())
  objectiveName     String            @unique @map("objective_name")
  category          AssertionCategory
  description       String
  objectiveCategory String            @default("financial-audit") @map("objective_category")

  controls ControlObjectiveMapping[]
  findings Finding[]

  @@map("dim_control_objective")
}

// dim_owner dropped per CR-WB-CONTROLS-001 Step 3.
// Ownership resolved via ownerRoleId (string) OR ownerEmployeeId (FK)
// on fact_control. Both-with-mutex: exactly one must be non-null (C2).

model Scope {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  scopeType    ScopeType @map("scope_type")
  entity       String
  businessUnit String?   @map("business_unit")
  location     String?
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  controls Control[]

  @@unique([companyId, entity, businessUnit, location])
  @@map("dim_scope")
}

// ============================================================
// Dim_ControlType — Nature/Automation/Domain dimension
// CR-AUDITFORGE-001 Item 2
// ============================================================

model ControlTypeDim {
  id         String            @id @default(cuid())
  nature     ControlTypeNature
  automation ControlAutomation
  domain     ControlDomain     @default(BUSINESS)
  label      String            @unique
  createdAt  DateTime          @default(now()) @map("created_at")

  controls Control[]

  @@unique([nature, automation, domain])
  @@map("dim_control_type")
}

// ============================================================
// Employee — canonical identity dimension (ex-Auditor)
// Renamed from dim_auditor per Phase A (Path A confirmed).
// Audit-specific fields retained; HR fields added nullable.
// ============================================================

model Employee {
  id              String          @id @default(cuid())
  auditorId       String          @unique @map("auditor_id")
  companyId       String          @map("company_id")
  auditorName     String          @map("auditor_name")
  title           String?
  department      String?
  email           String?
  role            String          @default("STAFF")
  certifications  String?
  // Phase C: deprecated columns dropped — canonical data in dim_auditor_profile / fact_token_assessment
  hireDate        DateTime?       @map("hire_date")
  departureDate   DateTime?       @map("departure_date")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // HR fields (Phase A — nullable until backfill)
  firstName        String?         @map("first_name")
  lastName         String?         @map("last_name")
  preferredName    String?         @map("preferred_name")
  managerId        String?         @map("manager_id")
  roleId           String?         @map("role_id")
  departmentId     String?         @map("department_id")
  statusId         String?         @map("status_id")
  employmentType   EmploymentType? @map("employment_type")
  employeeTimeZone String?         @map("employee_time_zone")
  source           String          @default("internal")
  externalId       String?         @map("external_id")
  externalMetadata Json?           @map("external_metadata")

  company          Company             @relation(fields: [companyId], references: [id])
  manager          Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports    Employee[]          @relation("EmployeeManager")
  dimRole          Role?               @relation(fields: [roleId], references: [id])
  dimDepartment    Department?         @relation(fields: [departmentId], references: [id])
  dimStatus        EmployeeStatus?     @relation(fields: [statusId], references: [id])
  ledAudits        Audit[]             @relation("LeadAuditor")
  scopeAssignments AuditControlScope[] @relation("ScopeAssignee")
  teamAssignments  AuditAuditor[]
  factTimeEntries  TimeEntry[]
  users            User[]
  ownedControls    Control[]           @relation("ControlOwnerEmployee")
  // ownedFindings: Finding ownerEmployeeId is string-keyed in V1 (no FK relation)
  auditorProfile   AuditorProfile?
  statusChanges    StatusChange[]
  compChanges      CompChange[]
  tokenAssessments TokenAssessment[]

  @@index([companyId])
  @@map("dim_employee")
}

// ============================================================
// FACT TABLE — v0.4
// ============================================================

model Control {
  id                     String              @id @default(cuid())
  controlId              String              @map("control_id")
  companyId              String              @map("company_id")
  processId              String              @map("process_id")
  periodId               String              @map("period_id")
  ownerEmployeeId        String?             @map("owner_employee_id")
  ownerRoleId            String?             @map("owner_role_id")
  scopeId                String?             @map("scope_id")
  controlTypeId          String?             @map("control_type_id")
  description            String              @map("control_description")
  objective              String?             @map("control_objective")
  // controlType legacy enum dropped per CR-WB-CONTROLS-001 Step 2.
  // controlNature retained — cleanup deferred to future CR.
  controlNature          ControlNature       @default(MANUAL) @map("control_nature")
  controlFrequency       ControlFrequency    @default(MONTHLY) @map("control_frequency")
  keyControl             Boolean             @default(false) @map("key_control")
  designEffectiveness    EffectivenessStatus @default(NOT_TESTED) @map("design_effectiveness")
  operatingEffectiveness EffectivenessStatus @default(NOT_TESTED) @map("operating_effectiveness")

  // Lifecycle
  lifecycle      ControlLifecycle @default(DRAFT) @map("lifecycle_status")
  supersededById String?          @map("superseded_by_id")

  // Review workflow
  reviewStatus ReviewStatus @default(DRAFT) @map("review_status")

  // Versioning
  version      Int     @default(1)
  changeReason String? @map("change_reason")

  evidenceDescription String?  @map("evidence_description")
  testProcedure       String?  @map("test_procedure")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Bitemporal bridge (CR-WB-CONTROLS-001 Step 4, C7)
  effectiveDate       DateTime @map("effective_date")
  recordedDate        DateTime @map("recorded_date")
  previousFactId      String?  @map("previous_fact_id")
  source              String   @default("migration")
  sourceRecordId      String?  @map("source_record_id")

  // Dimension relations
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  process        Process         @relation(fields: [processId], references: [id])
  period         Period          @relation(fields: [periodId], references: [id])
  ownerEmployee  Employee?       @relation("ControlOwnerEmployee", fields: [ownerEmployeeId], references: [id])
  ownerRole      Role?           @relation("ControlOwnerRole", fields: [ownerRoleId], references: [id])
  scope          Scope?          @relation(fields: [scopeId], references: [id])
  controlTypeDim ControlTypeDim? @relation(fields: [controlTypeId], references: [id])
  supersededBy   Control?        @relation("ControlSupersedes", fields: [supersededById], references: [id])
  supersedes     Control[]       @relation("ControlSupersedes")

  // Bridge relations (M:M)
  risks      ControlRisk[]
  frameworks ControlFramework[]
  controlObjectives ControlObjectiveMapping[]

  // Status log
  statusLogs ControlStatusLog[]

  // v0.4: Audit scope
  auditScope AuditControlScope[]

  // Findings raised against this control
  findings Finding[]

  @@unique([companyId, controlId, periodId, version])
  @@index([companyId])
  @@index([processId])
  @@index([reviewStatus])
  @@index([lifecycle])
  @@index([controlTypeId])
  @@map("fact_control")
}

// ============================================================
// v0.4: Fact_Audit — CR-AUDITFORGE-004 (Planning Layer)
// State machine: PLANNING → FIELDWORK → REPORTING → COMPLETED
// Any → CANCELLED (requires rationale)
// COMPLETED = immutable
// ============================================================

model Audit {
  id            String      @id @default(cuid())
  auditId       String      @unique @map("audit_id")
  companyId     String      @map("company_id")
  periodId      String      @map("period_id")
  auditName     String      @map("audit_name")
  auditType     AuditType   @default(INTERNAL) @map("audit_type")
  status        AuditStatus @default(PLANNING)
  leadAuditorId String      @map("lead_auditor_id")
  startDate     DateTime?   @map("start_date")
  endDate       DateTime?   @map("end_date")
  reportDate    DateTime?   @map("report_date")
  scope         String? // narrative scope description
  methodology   String?
  cancelReason  String?     @map("cancel_reason")
  version       Int         @default(1)
  changeReason  String?     @map("change_reason")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  company         Company             @relation(fields: [companyId], references: [id])
  period          Period              @relation(fields: [periodId], references: [id])
  leadAuditor     Employee            @relation("LeadAuditor", fields: [leadAuditorId], references: [id])
  controlScope    AuditControlScope[]
  team            AuditAuditor[]
  factTimeEntries TimeEntry[]
  invoices        Invoice[]
  findings        Finding[]

  @@index([companyId])
  @@index([periodId])
  @@index([status])
  @@map("fact_audit")
}

// ============================================================
// v0.4: Bridge_Audit_Control — Audit Scope with rationale
// CR-AUDITFORGE-004 (Strong consensus, 8/9 seats)
// ============================================================

model AuditControlScope {
  id             String        @id @default(cuid())
  auditId        String        @map("audit_id")
  controlId      String        @map("control_id")
  inScope        Boolean       @default(true) @map("in_scope")
  scopeDecision  ScopeDecision @default(IN_SCOPE) @map("scope_decision")
  scopeRationale String?       @map("scope_rationale")
  assignedToId   String?       @map("assigned_to_id")
  targetDate     DateTime?     @map("target_date")
  validFrom      DateTime      @default(now()) @map("valid_from")
  validTo        DateTime?     @map("valid_to")
  createdAt      DateTime      @default(now()) @map("created_at")

  audit      Audit    @relation(fields: [auditId], references: [id])
  control    Control  @relation(fields: [controlId], references: [id])
  assignedTo Employee? @relation("ScopeAssignee", fields: [assignedToId], references: [id])

  @@unique([auditId, controlId, validFrom])
  @@index([auditId])
  @@index([controlId])
  @@map("bridge_audit_control")
}

// ============================================================
// BRIDGE TABLES — Effective dating (CR-AUDITFORGE-001 Item 1)
// ============================================================

model ControlRisk {
  controlId String    @map("control_id")
  riskId    String    @map("risk_id")
  validFrom DateTime  @default(now()) @map("valid_from")
  validTo   DateTime? @map("valid_to")

  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)
  risk    Risk    @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@id([controlId, riskId])
  @@index([validTo])
  @@map("bridge_control_risk")
}

model ControlFramework {
  controlId   String    @map("control_id")
  frameworkId String    @map("framework_id")
  validFrom   DateTime  @default(now()) @map("valid_from")
  validTo     DateTime? @map("valid_to")

  control   Control   @relation(fields: [controlId], references: [id], onDelete: Cascade)
  framework Framework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@id([controlId, frameworkId])
  @@index([validTo])
  @@map("bridge_control_framework")
}

model ControlObjectiveMapping {
  controlId          String    @map("control_id")
  controlObjectiveId String    @map("control_objective_id")
  validFrom          DateTime  @default(now()) @map("valid_from")
  validTo            DateTime? @map("valid_to")

  control          Control          @relation(fields: [controlId], references: [id], onDelete: Cascade)
  controlObjective ControlObjective @relation(fields: [controlObjectiveId], references: [id], onDelete: Cascade)

  @@id([controlId, controlObjectiveId])
  @@index([validTo])
  @@map("bridge_control_objective")
}

// ============================================================
// Workflow State Machine — ControlStatusLog
// CR-AUDITFORGE-001 Item 3
// ============================================================

model ControlStatusLog {
  id         String   @id @default(cuid())
  controlId  String   @map("control_id")
  fromStatus String   @map("from_status")
  toStatus   String   @map("to_status")
  statusType String   @map("status_type") // "REVIEW" or "LIFECYCLE"
  changedBy  String   @map("changed_by")
  changedAt       DateTime @default(now()) @map("changed_at")
  comment         String?

  // Bitemporal bridge (CR-WB-CONTROLS-001 Step 4)
  effectiveDate   DateTime @map("effective_date")
  recordedDate    DateTime @map("recorded_date")
  correctsFactId  String?  @map("corrects_fact_id")

  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@index([controlId])
  @@index([changedAt])
  @@map("sys_control_status_log")
}

// ============================================================
// Audit Trail — Silent Fix Prevention
// CR-AUDITFORGE-001 Item 4
// ============================================================

model AuditTrail {
  id             String   @id @default(cuid())
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  field          String?
  previousValues Json?    @map("previous_values")
  newValues      Json?    @map("new_values")
  userId         String   @map("user_id")
  timestamp      DateTime @default(now())
  rationale      String?

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
  @@map("sys_audit_trail")
}

// ============================================================
// TEMPLATE + DOCUMENT SYSTEM
// CR-AUDITFORGE-001 Item 5: Template snapshot
// ============================================================

model Template {
  id           String       @id @default(cuid())
  templateId   String       @unique @map("template_id")
  name         String
  templateType TemplateType @map("template_type")
  description  String?
  outputFormat OutputFormat @map("output_format")
  version      String       @default("1.0.0")
  definition   Json
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  generatedDocs GeneratedDocument[]

  @@map("sys_template")
}

model GeneratedDocument {
  id               String       @id @default(cuid())
  templateId       String       @map("template_id")
  companyId        String       @map("company_id")
  periodLabel      String       @map("period_label")
  fileName         String       @map("file_name")
  fileFormat       OutputFormat @map("file_format")
  templateVersion  String       @map("template_version")
  templateSnapshot Json?        @map("template_snapshot")
  draftVersion     Int          @default(1) @map("draft_version")
  docStatus        DocStatus    @default(DRAFT) @map("doc_status")
  dataHash         String?      @map("data_hash")
  frozenAt         DateTime?    @map("frozen_at")
  generatedBy      String?      @map("generated_by")
  generatedAt      DateTime     @default(now()) @map("generated_at")
  filePath         String?      @map("file_path")
  metadata         Json?

  template Template @relation(fields: [templateId], references: [id])

  @@index([companyId, periodLabel])
  @@index([docStatus])
  @@map("sys_generated_document")
}

// ============================================================
// ENUMS
// ============================================================

enum CompanySize {
  SMALL
  MEDIUM
  LARGE
}

enum PublicPrivate {
  PUBLIC
  PRIVATE
}

enum RiskCategory {
  FINANCIAL
  OPERATIONAL
  COMPLIANCE
  STRATEGIC
  TECHNOLOGY
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Legacy flat enums on Fact_Control
// ControlType enum dropped per CR-WB-CONTROLS-001 Step 2.
// Legacy flat enum replaced by dim_control_type FK (controlTypeId).

enum ControlNature {
  MANUAL
  AUTOMATED
  IT_DEPENDENT_MANUAL
}

// Dim_ControlType enums
enum ControlTypeNature {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
}

enum ControlAutomation {
  MANUAL
  AUTOMATED
  IT_DEPENDENT
}

enum ControlDomain {
  BUSINESS
  IT
  HYBRID
}

enum ControlFrequency {
  REAL_TIME
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  AD_HOC
}

enum EffectivenessStatus {
  EFFECTIVE
  INEFFECTIVE
  NOT_TESTED
  PARTIALLY_EFFECTIVE
}

enum ReviewStatus {
  DRAFT
  PREPARED
  REVIEWED
  APPROVED
  RETURN_FOR_COMMENTS
}

enum ControlLifecycle {
  DRAFT
  ACTIVE
  SUPERSEDED
  RETIRED
}

enum DocStatus {
  DRAFT
  FINAL
  ARCHIVED
}

enum ScopeType {
  ENTITY
  BUSINESS_UNIT
  LOCATION
}

enum AssertionCategory {
  TRANSACTION
  BALANCE
  DISCLOSURE
  GENERAL
}

enum TemplateType {
  RCM
  MCL
  WALKTHROUGH
  RISK_ASSESSMENT
  FRAMEWORK_MAP
  GAP_ANALYSIS
  CONTROL_DESCRIPTION
  TESTING_PLAN
  AUDIT_PLAN
}

enum OutputFormat {
  DOCX
  XLSX
  PDF
}

enum PeriodType {
  ANNUAL
  QUARTERLY
  CUSTOM
}

// v0.4 enums — CR-AUDITFORGE-004

enum AuditType {
  INTERNAL
  EXTERNAL
  REGULATORY
}

enum AuditStatus {
  PLANNING
  FIELDWORK
  REPORTING
  COMPLETED
  CANCELLED
}

enum ScopeDecision {
  IN_SCOPE
  OUT_OF_SCOPE
  DEFERRED
}

model AuditAuditor {
  id            String   @id @default(cuid())
  auditId       String   @map("audit_id")
  auditorId     String   @map("auditor_id")
  teamRole      String   @default("STAFF") // LEAD, SENIOR, STAFF, REVIEWER, PARTNER
  budgetHours   Float?   @map("budget_hours")
  assignedPhase String   @default("ALL") // PLANNING, FIELDWORK, REPORTING, ALL
  createdAt     DateTime @default(now()) @map("created_at")

  audit   Audit   @relation(fields: [auditId], references: [id])
  auditor Employee @relation(fields: [auditorId], references: [id])

  @@unique([auditId, auditorId])
  @@map("bridge_audit_auditor")
}

model TimeEntry {
  id           String   @id @default(cuid())
  auditorId    String
  engagementId String
  date         DateTime
  monthTag     String
  hours        Float
  timeType     String
  component    String
  category     String
  comments      String?
  createdAt     DateTime  @default(now())
  recordedDate  DateTime? @map("recorded_date")
  entryTimeZone String?   @map("entry_time_zone")

  auditor    Employee @relation(fields: [auditorId], references: [id])
  engagement Audit    @relation(fields: [engagementId], references: [id])

  @@map("fact_time_entry")
}

// ============================================================
// BILLING & REVENUE — Rates, Invoices, Accounts Receivable
// ============================================================

model BillingRate {
  id            String          @id @default(cuid())
  rateId        String          @unique @map("rate_id")
  companyId     String          @map("company_id")
  role          String
  rateType      BillingRateType @default(STANDARD) @map("rate_type")
  hourlyRate    Float           @map("hourly_rate")
  effectiveDate DateTime        @map("effective_date")
  currency      String          @default("USD")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  roleId        String?         @map("role_id")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dimRole Role?   @relation(fields: [roleId], references: [id])

  @@index([companyId])
  @@index([role])
  @@map("dim_billing_rate")
}

model Invoice {
  id           String        @id @default(cuid())
  invoiceId    String        @unique @map("invoice_id")
  companyId    String        @map("company_id")
  auditId      String        @map("audit_id")
  invoiceDate  DateTime      @map("invoice_date")
  dueDate      DateTime      @map("due_date")
  totalAmount  Float         @map("total_amount")
  billedHours  Float         @map("billed_hours")
  billingRate  Float         @map("billing_rate")
  currency     String        @default("USD")
  status       InvoiceStatus @default(DRAFT)
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  audit     Audit     @relation(fields: [auditId], references: [id])
  arEntries AREntry[]

  @@index([companyId])
  @@index([auditId])
  @@index([status])
  @@map("fact_invoice")
}

model AREntry {
  id             String   @id @default(cuid())
  arId           String   @unique @map("ar_id")
  companyId      String   @map("company_id")
  invoiceId      String   @map("invoice_id")
  paymentDate    DateTime? @map("payment_date")
  amountPaid     Float    @default(0) @map("amount_paid")
  paymentMethod  String?  @map("payment_method")
  writeOffAmount Float    @default(0) @map("write_off_amount")
  status         ARStatus @default(OUTSTANDING)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([invoiceId])
  @@index([status])
  @@map("fact_ar_entry")
}

enum BillingRateType {
  STANDARD
  BLENDED
  CUSTOM
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  WRITTEN_OFF
}

enum ARStatus {
  OUTSTANDING
  PARTIAL
  PAID
  WRITTEN_OFF
}

// ============================================================
// Dim_Severity — Shared platform dimension
// CR-WB-FINDINGS-001 Step 1
// ============================================================

model Severity {
  id        String   @id @default(cuid())
  level     String   @unique
  rank      Int      @unique
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  findings Finding[]

  @@map("dim_severity")
}

// ============================================================
// FINDINGS — Audit findings with severity, status, remediation
// CR-WB-FINDINGS-001: promoted to platform module
// ============================================================

model Finding {
  id                 String        @id @default(cuid())
  findingId          String        @unique @map("finding_id")
  companyId          String        @map("company_id")
  auditId            String        @map("audit_id")
  controlId          String?       @map("control_id")  // nullable until F1 backfill — 8 existing findings lack controlId
  title              String
  description        String
  severityId         String        @map("severity_id")
  status             FindingStatus @default(OPEN)
  // owner split per CR-WB-FINDINGS-001 Step 3 (same pattern as Controls C2)
  ownerRoleId        String?       @map("owner_role_id")
  ownerEmployeeId    String?       @map("owner_employee_id")
  targetDate         DateTime?     @map("target_date")
  closedDate         DateTime?     @map("closed_date")
  managementResponse String?       @map("management_response")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  // Bitemporal bridge (CR-WB-FINDINGS-001 Step 3, F5)
  effectiveDate      DateTime      @map("effective_date")
  recordedDate       DateTime      @map("recorded_date")
  previousFactId     String?       @map("previous_fact_id")
  source             String        @default("migration")
  sourceRecordId     String?       @map("source_record_id")

  // Cross-promoted sibling FK (CR-WB-FINDINGS-001 F1)
  controlObjectiveId String?       @map("control_objective_id")

  // Additional fields per council ratification
  occurrenceDate     DateTime?     @map("occurrence_date")
  priorFindingId     String?       @map("prior_finding_id")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  audit            Audit             @relation(fields: [auditId], references: [id])
  control          Control?          @relation(fields: [controlId], references: [id])
  severity         Severity          @relation(fields: [severityId], references: [id])
  // ownerRoleId and ownerEmployeeId are string-keyed in V1 (no FK).
  // Future V2 may add FK relations after owner data normalization.
  controlObjective ControlObjective? @relation(fields: [controlObjectiveId], references: [id])
  priorFinding     Finding?          @relation("FindingSupersedes", fields: [priorFindingId], references: [id])
  supersededBy     Finding[]         @relation("FindingSupersedes")
  statusChanges    FindingStatusChange[]

  @@index([auditId])
  @@index([severityId])
  @@index([status])
  @@index([controlId])
  @@map("fact_finding")
}

// ============================================================
// Fact_FindingStatusChange — Status transition audit trail
// CR-WB-FINDINGS-001 Step 2
// ============================================================

model FindingStatusChange {
  id                    String    @id @default(cuid())
  findingId             String    @map("finding_id")
  fromStatus            String?   @map("from_status")
  toStatus              String    @map("to_status")
  changedBy             String    @map("changed_by")
  reason                String
  effectiveDate         DateTime  @map("effective_date")
  recordedDate          DateTime  @map("recorded_date")
  correctsFactId        String?   @map("corrects_fact_id")

  // F8 — ACCEPTED_RISK governance fields
  approverEmployeeId    String?   @map("approver_employee_id")
  acceptedUntilDate     DateTime? @map("accepted_until_date")

  // F9 — closure receipt (Leo)
  closureEvidenceFactId String?   @map("closure_evidence_fact_id")

  finding Finding @relation(fields: [findingId], references: [id])

  @@index([findingId])
  @@map("fact_finding_status_change")
}

enum FindingStatus {
  OPEN
  IN_REMEDIATION
  CLOSED
  ACCEPTED
}

// ============================================================
// HR & PEOPLE — Phase A Migration 1 (additive)
// CR-WB-HRPEOPLE-001, CR-WB-HRPEOPLE-002
// ============================================================

enum StatusParent {
  ACTIVE
  ON_LEAVE
  INACTIVE
  PENDING
}

enum TokenPolarity {
  STRENGTH
  GAP
}

enum TokenLayer {
  UNIVERSAL
  ROLE_SPECIFIC
}

enum EmploymentType {
  FT
  PT
  CONTRACTOR
  INTERN
}

enum PayCadence {
  HOURLY
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  ANNUAL
}

enum ChangeType {
  HIRE
  RAISE
  PROMOTION
  DEMOTION
  STRUCTURE_CHANGE
  BONUS_ADJ
  TERMINATION_PAY
  CORRECTION
}

model Role {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  label     String
  level     Int
  createdAt DateTime @default(now()) @map("created_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees    Employee[]
  controls     Control[]     @relation("ControlOwnerRole")
  // findings: Finding ownerRoleId is string-keyed in V1 (no FK relation)
  billingRates BillingRate[]

  @@unique([companyId, label])
  @@index([companyId])
  @@map("dim_role")
}

model Department {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("dim_department")
}

model EmployeeStatus {
  id                String       @id @default(cuid())
  parent            StatusParent
  childLabel        String       @map("child_label")
  rehireEligible    Boolean      @default(false) @map("rehire_eligible")
  countsAsHeadcount Boolean      @default(true)  @map("counts_as_headcount")
  accruesPto        Boolean      @default(true)  @map("accrues_pto")
  onPayroll         Boolean      @default(true)  @map("on_payroll")
  onTimeClock       Boolean      @default(true)  @map("on_time_clock")
  createdAt         DateTime     @default(now()) @map("created_at")

  employees        Employee[]
  statusChangesFrom StatusChange[] @relation("StatusChangeFrom")
  statusChangesTo   StatusChange[] @relation("StatusChangeTo")

  @@unique([parent, childLabel])
  @@map("dim_employee_status")
}

model Token {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  polarity  TokenPolarity
  layer     TokenLayer
  createdAt DateTime      @default(now()) @map("created_at")

  assessments TokenAssessment[]

  @@map("dim_token")
}

// ============================================================
// PHASE A MIGRATION 3 — Payroll Facts, Audit Profile, Tokens
// CR-WB-PAYROLL-001, CR-WB-HRPEOPLE-001
// ============================================================

enum IndependenceType {
  INTERNAL
  EXTERNAL
  REGULATORY
}

model AuditorProfile {
  id              String           @id @default(cuid())
  employeeId      String           @unique @map("employee_id")
  independence    IndependenceType?
  firm            String?
  specializations String[]
  bio             String?
  councilSeat     String?          @map("council_seat")
  photoUrl        String?          @map("photo_url")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("dim_auditor_profile")
}

model StatusChange {
  id            String   @id @default(cuid())
  employeeId    String   @map("employee_id")
  effectiveDate DateTime @map("effective_date")
  recordedDate  DateTime @default(now()) @map("recorded_date")
  fromStatusId  String?  @map("from_status_id")
  toStatusId    String   @map("to_status_id")
  reason        String?
  authoredBy    String?  @map("authored_by")
  createdAt     DateTime @default(now()) @map("created_at")

  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromStatus EmployeeStatus? @relation("StatusChangeFrom", fields: [fromStatusId], references: [id])
  toStatus   EmployeeStatus  @relation("StatusChangeTo", fields: [toStatusId], references: [id])

  @@index([employeeId])
  @@index([effectiveDate])
  @@map("fact_status_change")
}

model CompChange {
  id            String     @id @default(cuid())
  employeeId    String     @map("employee_id")
  changeType    ChangeType @map("change_type")
  effectiveDate DateTime   @map("effective_date")
  recordedDate  DateTime   @default(now()) @map("recorded_date")
  priorRate     Decimal?   @map("prior_rate")
  newRate       Decimal    @map("new_rate")
  payType       String?    @map("pay_type")
  payCadence    PayCadence? @map("pay_cadence")
  reason        String?
  authoredBy    String?    @map("authored_by")
  createdAt     DateTime   @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([effectiveDate])
  @@map("fact_comp_change")
}

model PayrollRun {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  periodStart  DateTime @map("period_start")
  periodEnd    DateTime @map("period_end")
  runDate      DateTime @map("run_date")
  recordedDate DateTime @default(now()) @map("recorded_date")
  runType      String   @map("run_type")
  totalGross   Decimal  @map("total_gross")
  totalNet     Decimal? @map("total_net")
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([periodStart, periodEnd])
  @@map("fact_payroll_run")
}

model TokenAssessment {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  tokenId    String   @map("token_id")
  score      Int
  assessedAt DateTime @map("assessed_at")
  assessedBy String?  @map("assessed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  token    Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tokenId])
  @@map("fact_token_assessment")
}

